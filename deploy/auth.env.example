# Copy to .local/oauth.env; fill credentials locally. Never commit that file.
# This example configures Google's standards-based OIDC provider.
AUTH_PROXY_LOGIN_PROVIDERS=google
AUTH_PROXY_LOGIN_GOOGLE_ISSUER=https://accounts.google.com
AUTH_PROXY_LOGIN_GOOGLE_CLIENT_ID=replace-with-your-client-id
AUTH_PROXY_LOGIN_GOOGLE_CLIENT_SECRET=replace-with-your-client-secret
AUTH_PROXY_LOGIN_GOOGLE_REDIRECT_URL=https://auth.example.com/auth/callback/google
AUTH_PROXY_SESSION_STORE=jwt
AUTH_PROXY_SESSION_JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
AUTH_PROXY_SESSION_COOKIE_SECURE=true
SCITRERA_AUTH_EXTERNAL_ADDR=:8081
SCITRERA_AUTH_POST_LOGIN_TARGET=https://app.example.com
SCITRERA_AUTH_ALLOWED_REDIRECT_HOSTS=app.example.com
SCITRERA_AUTH_CHECKZ_ALLOWED_ORIGINS=https://app.example.com

# Keep scraping on a separate private port, or omit to use admin then internal.
# SCITRERA_AUTH_METRICS_ADDR=:9090
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_SERVICE_NAME=scitrera-auth-go
